<odoo>
    <record id="module_category_accounting" model="ir.module.category">
        <field name="name">Accounting</field>
    </record>

    <record id="res_groups_privilege_accounting" model="res.groups.privilege">
        <field name="name">Accounting</field>
        <field name="category_id" ref="module_category_accounting"/>
    </record>

    <record id="group_account_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_accounting"/>
    </record>

    <record id="group_account_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="res_groups_privilege_accounting"/>
        <field name="implied_ids" eval="[Command.link(ref('group_account_user'))]"/>
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
    </record>
</odoo>
