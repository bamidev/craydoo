<odoo>
    <record id="view_account_tax_tag_list" model="ir.ui.view">
        <field name="name">cd.account.tax.tag.list</field>
        <field name="model">cd.account.tax.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="applicability"/>
                <field name="tax_negate"/>
            </list>
        </field>
    </record>

    <record id="action_account_tax_tag" model="ir.actions.act_window">
        <field name="name">Tax Tags</field>
        <field name="res_model">cd.account.tax.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_account_tax_tag" name="Tax Tags" parent="menu_account_config"
              action="action_account_tax_tag" sequence="20"/>
</odoo>
