<odoo>
    <record id="view_account_account_list" model="ir.ui.view">
        <field name="name">cd.account.account.list</field>
        <field name="model">cd.account.account</field>
        <field name="arch" type="xml">
            <list delete="false">
                <field name="ledger"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_account_account_form" model="ir.ui.view">
        <field name="name">cd.account.account.form</field>
        <field name="model">cd.account.account</field>
        <field name="arch" type="xml">
            <form delete="false">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="ledger" readonly="id"/>
                        <field name="code" readonly="id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_account" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">cd.account.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_account_tigerbeetle" name="General Ledger" parent="menu_account_root" sequence="80"/>
    <menuitem id="menu_account_account" name="Accounts" parent="menu_account_tigerbeetle"
              action="action_account_account" sequence="10"/>
</odoo>
