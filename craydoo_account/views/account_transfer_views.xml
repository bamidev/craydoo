<odoo>
    <record id="view_account_transfer_list" model="ir.ui.view">
        <field name="name">cd.account.transfer.list</field>
        <field name="model">cd.account.transfer</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="name"/>
                <field name="ledger_id"/>
                <field name="type"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <field name="residual_amount"/>
            </list>
        </field>
    </record>

    <record id="action_account_transfer" model="ir.actions.act_window">
        <field name="name">Transfers</field>
        <field name="res_model">cd.account.transfer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_account_transfer_child_mixin_list" model="ir.ui.view">
        <field name="name">cd.account.transfer.child.mixin.list</field>
        <field name="model">cd.account.transfer.child.mixin</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <field name="ledger_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_account_transfer_child_mixin_form" model="ir.ui.view">
        <field name="name">cd.account.transfer.child.mixin.form</field>
        <field name="model">cd.account.transfer.child.mixin</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="transfer_id"/>
                        <field name="date"/>
                        <field name="ledger_id"/>
                        <field name="type"/>
                        <field name="billing_contact_id"/>
                    </group>
                    <group name="accounts" string="Accounts">
                        <field name="debit_account_id"/>
                        <field name="credit_account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_transfer_posted_list" model="ir.ui.view">
        <field name="name">cd.account.transfer.posted.list</field>
        <field name="model">cd.account.transfer.posted</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_account_transfer_child_mixin_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="edit">false</attribute>
                <attribute name="delete">false</attribute>
            </xpath>
            <xpath expr="//field[@name='credit_account_id']" position="after">
                <field name="amount_currency" />
                <field name="currency_id" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="view_account_transfer_posted_form" model="ir.ui.view">
        <field name="name">cd.account.transfer.posted.form</field>
        <field name="model">cd.account.transfer.posted</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_account_transfer_child_mixin_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="edit">false</attribute>
                <attribute name="delete">false</attribute>
            </xpath>
            <xpath expr="//group[@name='accounts']" position="after">
                <group string="Amount">
                    <field name="amount_currency" />
                    <field name="currency_id" invisible="1" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_account_transfer_posted" model="ir.actions.act_window">
        <field name="name">Posted</field>
        <field name="res_model">cd.account.transfer.posted</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_account_transfer_pending_list" model="ir.ui.view">
        <field name="name">cd.account.transfer.pending.list</field>
        <field name="model">cd.account.transfer.pending</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_account_transfer_child_mixin_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="delete">false</attribute>
            </xpath>
            <xpath expr="//field[@name='credit_account_id']" position="after">
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="amount_currency"/>
                <field name="posted_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_transfer_pending_form" model="ir.ui.view">
        <field name="name">cd.account.transfer.pending.form</field>
        <field name="model">cd.account.transfer.pending</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_account_transfer_child_mixin_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="delete">false</attribute>
            </xpath>
            <xpath expr="//group[@name='accounts']" position="after">
                <group string="Amount">
                    <field name="amount_currency"/>
                    <field name="currency_id" invisible="1" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_account_transfer_pending" model="ir.actions.act_window">
        <field name="name">Pending</field>
        <field name="res_model">cd.account.transfer.pending</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_account_transfer" name="Transfers" parent="menu_account_general_ledger"
              action="action_account_transfer" sequence="20"/>
    <menuitem id="menu_account_transfer_pending" name="Pending" parent="menu_account_transfer"
              action="action_account_transfer_pending" sequence="10"/>
    <menuitem id="menu_account_transfer_posted" name="Posted" parent="menu_account_transfer"
              action="action_account_transfer_posted" sequence="20"/>
</odoo>
