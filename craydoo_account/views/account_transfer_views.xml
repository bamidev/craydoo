<odoo>
    <record id="view_account_transfer_list" model="ir.ui.view">
        <field name="name">cd.account.transfer.list</field>
        <field name="model">cd.account.transfer</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="id"/>
                <field name="ledger"/>
                <field name="code"/>
                <field name="debit_account"/>
                <field name="credit_account"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="view_account_transfer_form" model="ir.ui.view">
        <field name="name">cd.account.transfer.form</field>
        <field name="model">cd.account.transfer</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <field name="id" string="Transfer ID"/>
                        <field name="ledger"/>
                        <field name="code"/>
                        <field name="flag_linked"/>
                        <field name="linked_ids"/>
                    </group>
                    <group string="Amount">
                        <field name="debit_account"/>
                        <field name="credit_account"/>
                        <field name="amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_transfer" model="ir.actions.act_window">
        <field name="name">Transfers</field>
        <field name="res_model">cd.account.transfer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_account_transfer" name="Transfers" parent="menu_account_tigerbeetle"
              action="action_account_transfer" sequence="20"/>
</odoo>
