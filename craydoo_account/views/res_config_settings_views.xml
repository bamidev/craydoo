<odoo>
    <record id="res_config_settings_view_form_inherit_craydoo_account" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.craydoo.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Accounting" string="Accounting" name="craydoo_account">
                    <block title="Transfers" name="craydoo_account_transfer_setting_container">
                        <setting id="transfer_convert_immediately_setting"
                                 string="Foreign Currency Transfers"
                                 help="Convert a foreign-currency transfer to its ledger's currency
                                       immediately when it's posted, instead of waiting until it's
                                       reconciled.">
                            <field name="account_transfer_convert_immediately"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
