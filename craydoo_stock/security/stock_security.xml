<odoo>
    <record id="module_category_stock" model="ir.module.category">
        <field name="name">Inventory</field>
    </record>

    <record id="res_groups_privilege_stock" model="res.groups.privilege">
        <field name="name">Inventory</field>
        <field name="category_id" ref="module_category_stock"/>
    </record>

    <record id="group_stock_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_stock"/>
    </record>

    <record id="group_stock_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="res_groups_privilege_stock"/>
        <field name="implied_ids" eval="[Command.link(ref('group_stock_user'))]"/>
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
    </record>
</odoo>
