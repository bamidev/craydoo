<odoo>
    <record id="view_stock_picking_order_list" model="ir.ui.view">
        <field name="name">cd.stock.picking.order.list</field>
        <field name="model">cd.stock.picking.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_stock_picking_order_form" model="ir.ui.view">
        <field name="name">cd.stock.picking.order.form</field>
        <field name="model">cd.stock.picking.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" type="object" string="Validate"
                            invisible="state == 'done'" class="btn-primary"/>
                </header>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <field name="state" invisible="1"/>
                        <field name="group_id" invisible="not group_id"/>
                    </group>
                    <field name="order_line_ids" readonly="state == 'done'">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_picking_order" model="ir.actions.act_window">
        <field name="name">Picking Orders</field>
        <field name="res_model">cd.stock.picking.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_stock_picking_order" name="Picking Orders" parent="menu_stock_root"
              action="action_stock_picking_order" sequence="10"/>
</odoo>
