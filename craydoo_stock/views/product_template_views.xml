<odoo>
    <record id="view_product_template_form_inherit_stock" model="ir.ui.view">
        <field name="name">cd.product.template.form.inherit.stock</field>
        <field name="model">cd.product.template</field>
        <field name="inherit_id" ref="craydoo_product.view_product_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='track_by_serial']" position="after">
                <button name="action_enable_track_by_serial" type="object" string="Enable"
                        invisible="track_by_serial" groups="craydoo_stock.group_stock_admin"/>
            </xpath>
        </field>
    </record>
</odoo>
