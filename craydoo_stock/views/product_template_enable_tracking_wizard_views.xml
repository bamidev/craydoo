<odoo>
    <record id="view_product_template_enable_tracking_wizard_form" model="ir.ui.view">
        <field name="name">cd.product.template.enable.tracking.wizard.form</field>
        <field name="model">cd.product.template.enable.tracking.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="template_id" invisible="1"/>
                <field name="field_name" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <field name="message" readonly="1" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_create_copy" type="object"
                            string="Create Copy" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
