<odoo>
    <record id="view_product_category_form_inherit_account_product" model="ir.ui.view">
        <field name="name">cd.product.category.form.inherit.account.product</field>
        <field name="model">cd.product.category</field>
        <field name="inherit_id" ref="craydoo_product.view_product_category_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="income_account_id"/>
                <field name="expense_account_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_inherit_account_product" model="ir.ui.view">
        <field name="name">cd.product.template.form.inherit.account.product</field>
        <field name="model">cd.product.template</field>
        <field name="inherit_id" ref="craydoo_product.view_product_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="income_account_id"/>
                <field name="expense_account_id"/>
            </xpath>
        </field>
    </record>
</odoo>
