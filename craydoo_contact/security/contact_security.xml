<odoo>
    <record id="module_category_contacts" model="ir.module.category">
        <field name="name">Contacts</field>
    </record>

    <record id="res_groups_privilege_contacts" model="res.groups.privilege">
        <field name="name">Contacts</field>
        <field name="category_id" ref="module_category_contacts"/>
    </record>

    <record id="group_contact_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="privilege_id" ref="res_groups_privilege_contacts"/>
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
    </record>
</odoo>
