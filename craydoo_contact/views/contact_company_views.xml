<odoo>
    <record id="view_contact_company_list" model="ir.ui.view">
        <field name="name">cd.contact.company.list</field>
        <field name="model">cd.contact.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vat_id"/>
                <field name="city"/>
                <field name="country"/>
            </list>
        </field>
    </record>

    <record id="view_contact_company_form" model="ir.ui.view">
        <field name="name">cd.contact.company.form</field>
        <field name="model">cd.contact.company</field>
        <field name="inherit_id" ref="view_contact_base_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="vat_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_contact_company_search" model="ir.ui.view">
        <field name="name">cd.contact.company.search</field>
        <field name="model">cd.contact.company</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_current_company" string="Current Company"
                        domain="[('company_id', 'in', [False] + allowed_company_ids)]"/>
            </search>
        </field>
    </record>

    <record id="action_contact_company" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">cd.contact.company</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_current_company': 1}</field>
    </record>

    <menuitem id="menu_contact_company" name="Companies" parent="menu_contact_root"
              action="action_contact_company" sequence="20"/>
</odoo>
