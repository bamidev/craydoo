<odoo>
    <record id="view_contact_company_list" model="ir.ui.view">
        <field name="name">cd.contact.company.list</field>
        <field name="model">cd.contact.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vat_id"/>
                <field name="city"/>
                <field name="country"/>
            </list>
        </field>
    </record>

    <record id="view_contact_company_form" model="ir.ui.view">
        <field name="name">cd.contact.company.form</field>
        <field name="model">cd.contact.company</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="vat_id"/>
                    </group>
                    <notebook>
                        <page string="Emails">
                            <field name="emails">
                                <list editable="bottom">
                                    <field name="address"/>
                                    <field name="is_primary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Phones">
                            <field name="phones">
                                <list editable="bottom">
                                    <field name="number"/>
                                    <field name="type"/>
                                    <field name="is_primary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Websites">
                            <field name="websites">
                                <list editable="bottom">
                                    <field name="url"/>
                                    <field name="type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Address">
                        <field name="street"/>
                        <field name="street2"/>
                        <field name="city"/>
                        <field name="zip"/>
                        <field name="state"/>
                        <field name="country"/>
                    </group>
                    <group string="Other">
                        <field name="tz"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contact_company" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">cd.contact.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_contact_company" name="Companies" parent="menu_contact_root"
              action="action_contact_company" sequence="20"/>
</odoo>
