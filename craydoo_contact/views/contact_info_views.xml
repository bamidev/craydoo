<odoo>
    <record id="view_contact_info_form" model="ir.ui.view">
        <field name="name">cd.contact.info.form</field>
        <field name="model">cd.contact.info</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="locked" invisible="1"/>
                    <group invisible="not locked">
                        <div class="alert alert-info" role="alert">
                            This record is locked and cannot be modified.
                        </div>
                    </group>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Emails">
                            <field name="email_ids">
                                <list editable="bottom">
                                    <field name="address"/>
                                    <field name="is_primary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Phones">
                            <field name="phone_ids">
                                <list editable="bottom">
                                    <field name="number"/>
                                    <field name="type"/>
                                    <field name="is_primary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Websites">
                            <field name="website_ids">
                                <list editable="bottom">
                                    <field name="url"/>
                                    <field name="type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Address">
                        <field name="street"/>
                        <field name="house"/>
                        <field name="address_extra"/>
                        <field name="city"/>
                        <field name="zip"/>
                        <field name="state_id"/>
                        <field name="country_id"/>
                    </group>
                    <group string="Other">
                        <field name="tz"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_contact_root" name="Contacts"/>
</odoo>
